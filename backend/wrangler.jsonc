{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "thomian-backend",
	"main": "src/index.ts",
	"compatibility_date": "2025-01-27",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"vars": {
		"JWT_SECRET": "replace-with-a-secure-secret-key"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "thomian-db",
			"database_id": "111f9a96-13a7-4340-8cc2-9ad9c3873a69",
			"migrations_dir": "drizzle/migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "1c5c86cfa8364f5f8d48b40a2ddfb410"
		}
	],
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "thomian-assets"
		}
	],
	"ai": {
		"binding": "AI"
	}
}